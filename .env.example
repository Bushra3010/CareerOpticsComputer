# ============================================================================
# Career Optics CCMS — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# Every value below is intentionally empty; there are no working defaults.
# ============================================================================

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used for migrations and pgTAP in CI.
SUPABASE_DB_URL=

# --- Application -----------------------------------------------------------
# Canonical origin. Used to build certificate QR verification URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local | preview | staging | production
NEXT_PUBLIC_APP_ENV=local

# --- Secrets ---------------------------------------------------------------
# Keyed HMAC for government-ID duplicate detection. The plaintext ID is never
# stored. Rotating this key invalidates existing duplicate checks.
GOV_ID_HMAC_KEY=
# Signs invitation and student activation tokens.
INVITE_TOKEN_SECRET=
# Signs the payload embedded in certificate verification.
CERTIFICATE_SIGNING_KEY=
# Bearer secret required by /api/internal/jobs/run (Vercel Cron).
CRON_SECRET=

# --- Payments (Phase 5) ----------------------------------------------------
# none | razorpay | stripe
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# --- Notifications (Phase 5) ----------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# --- Document generation (Phase 4) ----------------------------------------
# chromium | external
PDF_RENDERER=chromium
PDF_SERVICE_URL=
PDF_SERVICE_TOKEN=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate limiting ---------------------------------------------------------
# memory | upstash. `memory` is single-instance only and is for local use.
RATE_LIMIT_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Uploads ---------------------------------------------------------------
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
