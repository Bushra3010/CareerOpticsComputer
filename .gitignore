# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never, the template always.
# .env.example must be committed: PRD §16.2 requires the exact variable list to
# be documented, and without it nobody can set the project up from a clone.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env
.env.local
.env*.local

# Supabase
supabase/.temp
supabase/.branches

# Test output
/test-results
/playwright-report
/coverage

# Generated by hand for one-off SQL-editor application; regenerate from supabase/migrations/
apply-phase-0.sql
verify-phase-0.sql
